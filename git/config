# Personal Git config (XDG location: ~/.config/git/config)
# Base identity = personal. Repos under ~/work/reckit/ override to the reckit
# identity via the includeIf at the bottom of this file.

[user]
	name = Youssef
	email = youssef.altai@icloud.com
	signingkey = ~/.ssh/id_ed25519_personal.pub

# --- SSH commit signing (no GPG toolchain) ---------------------------------
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# --- Sane 2026 defaults -----------------------------------------------------
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[branch]
	sort = -committerdate
[column]
	ui = auto

# --- Diffs via delta --------------------------------------------------------
[core]
	excludesfile = ~/.config/git/ignore
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true

# --- Per-company identity overrides ----------------------------------------
# Any repo whose path is under ~/work/reckit/ uses the reckit identity.
# Add more [includeIf "gitdir:~/work/<company>/"] blocks later as needed.
[includeIf "gitdir:~/work/reckit/"]
	path = config-reckit
