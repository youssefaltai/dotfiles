# Personal Git config (XDG location: ~/.config/git/config)
# Base identity = personal. Repos under ~/work/reckit/ and ~/work/noon/ override
# to their respective company identities via the includeIf blocks at the
# bottom of this file.

[user]
	name = Youssef
	email = youssef.altai@icloud.com
	signingkey = ~/.ssh/id_ed25519_personal.pub

# --- SSH commit signing (no GPG toolchain) ---------------------------------
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

# --- Sane 2026 defaults -----------------------------------------------------
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[branch]
	sort = -committerdate
[column]
	ui = auto

# --- Diffs via delta --------------------------------------------------------
[core]
	excludesfile = ~/.config/git/ignore
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true

# --- Company GitHub orgs → company SSH aliases ------------------------------
# fastfishio is noon's GitHub org — always reach it via the github-noon alias
# (noon SSH key). Lives in the base config (not config-noon) because clones
# land outside ~/work/noon (e.g. yarn git-dep clones into ~/.cache/yarn),
# where the gitdir includeIf below wouldn't apply.
[url "git@github-noon:fastfishio/"]
	insteadOf = git@github.com:fastfishio/
[url "ssh://git@github-noon/fastfishio/"]
	insteadOf = ssh://git@github.com/fastfishio/

# --- Per-company identity overrides ----------------------------------------
# Any repo whose path is under ~/work/reckit/ uses the reckit identity, and
# under ~/work/noon/ uses the noon identity.
# Add more [includeIf "gitdir:~/work/<company>/"] blocks later as needed.
[includeIf "gitdir:~/work/reckit/"]
	path = config-reckit
[includeIf "gitdir:~/work/noon/"]
	path = config-noon
[includeIf "gitdir:~/work/dolab-marcom/"]
	path = config-dolab-marcom
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
