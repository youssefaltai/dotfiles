# dolab-marcom (client) identity — applied only to repos under ~/work/dolab-marcom/.
# Generated by `ctx sync` from ~/.config/contexts.toml. Do not edit.
#
# Tech lead, solo-developing "Kol Hagty" — a marketing platform and discovery
# app for Egyptian women. The DoLab-marcom GitHub account keeps its email
# private, so commits use its GitHub noreply address; that still attributes them
# to the account.
[user]
	email = 300489642+DoLab-marcom@users.noreply.github.com

# No dedicated signing key on disk yet, so commits here are signed with the
# personal key from the base config and will show as Unverified under
# DoLab-marcom. GitHub refuses the same key on two accounts. Fix with:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_dolab -C dolab-marcom
#   GH_CONFIG_DIR=~/.config/gh-dolab gh ssh-key add ~/.ssh/id_ed25519_dolab.pub --type signing
