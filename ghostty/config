# ~/.config/ghostty/config — minimal. Reference: https://ghostty.org/docs/config/reference
# Inspect the resolved config any time with:  ghostty +show-config

# Font — JetBrainsMono Nerd Font supplies the icon glyphs used by eza/starship/nvim
font-family = JetBrainsMono Nerd Font
font-size = 15
font-thicken = true

# Theme — matches the kanagawa colorscheme used in Neovim (one look everywhere)
theme = Kanagawa Wave

# Window polish
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = tabs
cursor-style = bar
mouse-hide-while-typing = true

# Keyboard — make the LEFT Option key behave as Alt/Meta so terminal apps
# (e.g. tmux's M-hjkl pane resize) can see it. The RIGHT Option key stays a
# normal macOS compose key, so é / em-dash / etc. still type fine.
macos-option-as-alt = left
