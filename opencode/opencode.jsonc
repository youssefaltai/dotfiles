{
  // OpenCode global config — schema-validated (opencode refuses to start on
  // invalid fields). Loaded once at startup; restart opencode after editing.
  // Companion files in this dir: AGENTS.md (operating manual, auto-loaded),
  // plugins/guard.ts (bash guardrails), agents/, commands/, skills/, prompts/,
  // memory/ (persistent memory; index auto-loaded via "instructions").
  "$schema": "https://opencode.ai/config.json",

  // --- Persistent memory --------------------------------------------------
  // Loads the memory INDEX into every session (combined with AGENTS.md);
  // individual memories under memory/ are read on demand. Relative paths
  // resolve against this config's directory. Protocol: AGENTS.md §10.
  "instructions": ["memory/MEMORY.md"],

  // --- Models (DeepSeek direct API; auth in ~/.local/share/opencode/auth.json) ---
  // Main model for sessions. small_model handles cheap internal tasks
  // (session titles, summaries) so they don't burn main-model tokens.
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",

  // Updates come via Homebrew only (brew upgrade regenerates the Brewfile);
  // just notify when a newer version exists instead of self-updating.
  "autoupdate": "notify",

  // --- MCP Servers ------------------------------------------------------------
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  },

  // --- LSP Servers ------------------------------------------------------------
  "lsp": true,  // enable LSP support (for code completion, hover, etc.)


  // --- Permissions ------------------------------------------------------------
  // Ported from the Claude Code personal profile's settings.json (allow/deny).
  // NOTE: within each tool's pattern map, the LAST matching rule wins — broad
  // rules first, narrow overrides after.
  "permission": {
    "read": {
      "*": "allow",
      // secrets — denied to the Read tool. NOTE: allowlisted bash tools
      // (cat, rg, ...) can still read files without a prompt; bare
      // interpreters (node/npx/python3/uv) are excluded from the bash
      // allowlist below for exactly that reason. Residual risk accepted.
      "~/.ssh/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/gh-reckit/**": "deny",
      "~/.config/gh-noon/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/context7_key": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      // guardrail core: guard.ts stays user-maintained (one step removed from
      // agents so no single agent action can defang it); other plugins and the
      // rest of the opencode config are agent-editable.
      "~/.config/opencode/plugins/guard.ts": "deny",
      "~/.config/claude/hooks/**": "deny",
      "~/.claude/settings.json": "deny",
      "~/.claude-reckit/settings.json": "deny"
    },
    "bash": {
      "*": "ask",
      // everyday tools — ported from the Claude personal profile, then pruned:
      // no interactive/pager tools (fzf, zoxide, delta, lazygit) and no bare
      // interpreters (node, npx, python3, uv — they'd run arbitrary code and
      // bypass the read denies without a prompt; allow per-project instead).
      "git *": "allow",
      "gh *": "allow",
      "brew *": "allow",
      "mise *": "allow",
      "ls *": "allow",
      "eza *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "jq *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "make *": "allow",
      // hard denies (guard.ts additionally blocks obfuscated variants)
      "security *": "deny",
      "claude auth *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    // system maintenance regularly works across ~/.config and ~/work from any
    // cwd; everything else outside the project dir still asks.
    "external_directory": {
      "*": "ask",
      "~/.config/**": "allow",
      "~/work/**": "allow"
    }
  }
}
