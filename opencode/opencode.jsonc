{
  // OpenCode global config — schema-validated (opencode refuses to start on
  // invalid fields). Loaded once at startup; restart opencode after editing.
  // Companion files in this dir: AGENTS.md (operating manual, auto-loaded),
  // plugins/guard.ts (bash guardrails), agents/, commands/, skills/, prompts/,
  // memory/ (persistent memory; index auto-loaded via "instructions").
  "$schema": "https://opencode.ai/config.json",

  // --- Instructions loaded into every session --------------------------------
  // memory/MEMORY.md: the memory INDEX (individual memories under memory/ are
  // read on demand; protocol in AGENTS.md §10).
  // prompts/claude-code-norms.md: behavioral norms ported from Claude Code —
  // loaded as instructions rather than replacing agent system prompts, so
  // OpenCode's built-in tool guidance stays intact and JSON-only subagent
  // contracts still win. Relative paths resolve against this config's dir.
  "instructions": ["memory/MEMORY.md", "prompts/claude-code-norms.md"],

  // --- Models (DeepSeek direct API; auth in ~/.local/share/opencode/auth.json) ---
  // Main model for sessions. small_model handles cheap internal tasks
  // (session titles, summaries) so they don't burn main-model tokens.
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",

  // Effort variants ≈ Claude Code's /effort + thinking toggle: cycle with the
  // variant_cycle keybind (ctrl+t). No custom variants needed — the models.dev
  // registry marks deepseek-v4-pro/-flash with reasoning_options (thinking
  // toggle + effort high|max) and OpenCode synthesizes the cycleable variants
  // from that metadata. Defining variants here would OVERRIDE the built-ins,
  // so deliberately left out.

  // Updates come via Homebrew only (brew upgrade regenerates the Brewfile);
  // just notify when a newer version exists instead of self-updating.
  "autoupdate": "notify",

  // --- Primary agents = Claude Code permission modes -------------------------
  // Tab / Shift+Tab cycles these, replicating Claude Code's Shift+Tab
  // permission-mode cycling: default (edits ask) -> accept-edits (edits
  // auto-approved) -> plan (read-only research). Subagents in agents/ are
  // unaffected. Per-agent permission maps are specified IN FULL (base rule +
  // denies) rather than relying on merge semantics with the global map.
  "default_agent": "default",
  "agent": {
    // built-in build is replaced by "default"/"accept-edits" below
    "build": { "disable": true },
    "default": {
      "mode": "primary",
      "description": "Standard mode — file edits ask for approval (Claude Code default mode)",
      "permission": {
        "edit": {
          "*": "ask",
          "~/.ssh/**": "deny",
          "~/.local/share/opencode/auth.json": "deny",
          "~/.config/opencode/plugins/guard.ts": "deny",
          "~/.config/claude/hooks/**": "deny",
          "~/.claude/settings.json": "deny",
          "~/.claude-reckit/settings.json": "deny"
        }
      }
    },
    "accept-edits": {
      "mode": "primary",
      "description": "Accept-edits mode — edits and filesystem commands auto-approved (Claude Code acceptEdits)",
      "permission": {
        // edit falls through to the global map ("*": allow + denies);
        // bash gets the filesystem verbs on top of the global allowlist.
        // Claude Code acceptEdits auto-approves the filesystem verbs, incl.
        // rm — guard.ts still hard-blocks catastrophic/guardrail-targeting rm.
        "bash": {
          "mv *": "allow",
          "rm *": "allow",
          "rmdir *": "allow"
        }
      }
    },
    "plan": {
      // built-in plan agent (keeps its planning prompt); permissions tightened
      // from ask to a true read-only profile (Claude Code plan mode).
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "ls *": "allow",
          "eza *": "allow",
          "cat *": "allow",
          "bat *": "allow",
          "rg *": "allow",
          "fd *": "allow",
          "jq *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "wc *": "allow",
          "grep *": "allow",
          "find *": "allow",
          "which *": "allow",
          "pwd": "allow",
          "echo *": "allow"
        }
      }
    }
  },

  // --- MCP Servers ------------------------------------------------------------
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    }
  },

  // --- LSP Servers ------------------------------------------------------------
  "lsp": true,  // enable LSP support (for code completion, hover, etc.)


  // --- Permissions ------------------------------------------------------------
  // Ported from the Claude Code personal profile's settings.json (allow/deny).
  // NOTE: within each tool's pattern map, the LAST matching rule wins — broad
  // rules first, narrow overrides after.
  "permission": {
    "read": {
      "*": "allow",
      // secrets — denied to the Read tool. NOTE: allowlisted bash tools
      // (cat, rg, ...) can still read files without a prompt; bare
      // interpreters (node/npx/python3/uv) are excluded from the bash
      // allowlist below for exactly that reason. Residual risk accepted.
      "~/.ssh/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.config/gh-reckit/**": "deny",
      "~/.config/gh-noon/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "~/.local/share/opencode/context7_key": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      // guardrail core: guard.ts stays user-maintained (one step removed from
      // agents so no single agent action can defang it); other plugins and the
      // rest of the opencode config are agent-editable.
      "~/.config/opencode/plugins/guard.ts": "deny",
      "~/.config/claude/hooks/**": "deny",
      "~/.claude/settings.json": "deny",
      "~/.claude-reckit/settings.json": "deny"
    },
    "bash": {
      "*": "ask",
      // everyday tools — ported from the Claude personal profile, then pruned:
      // no interactive/pager tools (fzf, zoxide, delta, lazygit) and no bare
      // interpreters (node, npx, python3, uv — they'd run arbitrary code and
      // bypass the read denies without a prompt; allow per-project instead).
      "git *": "allow",
      "gh *": "allow",
      "brew *": "allow",
      "mise *": "allow",
      "ls *": "allow",
      "eza *": "allow",
      "cat *": "allow",
      "bat *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "jq *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "make *": "allow",
      // hard denies (guard.ts additionally blocks obfuscated variants)
      "security *": "deny",
      "claude auth *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    // system maintenance regularly works across ~/.config and ~/work from any
    // cwd; everything else outside the project dir still asks.
    "external_directory": {
      "*": "ask",
      "~/.config/**": "allow",
      "~/work/**": "allow"
    }
  }
}
