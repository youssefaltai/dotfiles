// PROPOSED replacement for guard.ts — 2026-07-08 review findings applied.
// Review, then apply YOURSELF (the guard is user-maintained by policy):
//   mv ~/.config/opencode/plugins/guard.ts.proposed ~/.config/opencode/plugins/guard.ts
//
// Changes vs the current guard.ts (threat model unchanged: ACCIDENTAL agent
// damage, not adversarial humans — command substitution/env-indirection
// bypasses remain out of scope):
//   1. Word boundary before `rm` — fixes false positives where words ending
//      in "rm" (terraform, confirm, perform...) plus a guarded path anywhere
//      in the command got blocked.
//   2. Quoted paths covered — `rm -rf "$HOME"/.claude`, `rm -rf "/"` (idiomatic
//      shell quoting used to sail through rules 4-6).
//   3. Subpath deletion covered — `rm -rf ~/.claude/projects` and
//      `rm -rf ~/.claude/*` are as destructive as deleting the dir and now
//      block (legit inner cleanups must be run manually by the user).
//   4. Long-form GNU flags — `rm --recursive --force /` now blocks.
//   5. Backslash line-continuations — multi-line formatted commands no longer
//      slip rules 1/3/4/5 (`\` + newline is treated as in-command whitespace).
//   6. Path traversal — `rm -rf ~/./.claude` now blocks.
//
// Inspects every `bash` tool call and BLOCKS (by throwing) a small, tight set
// of irreversible/dangerous operations. File-path protection (secrets, config,
// auth.json) is handled declaratively by `permission` rules in opencode.jsonc;
// this plugin only inspects Bash command strings, closing the shell path
// around those rules.
//
// Loaded automatically from ~/.config/opencode/plugins/ at startup (no config
// entry needed). This file is edit-protected via permission rules — the user
// maintains it manually. Other plugins in this directory and the rest of the
// OpenCode config are agent-editable (policy change 2026-07-05).

import type { Plugin } from "@opencode-ai/plugin"

// Building blocks (kept as strings so each rule below stays one readable line):
// WS — in-command whitespace: spaces/tabs/newlines OR a backslash line-continuation.
const WS = String.raw`(?:\s|\\\r?\n)+`
// RM — the rm verb at a token boundary, with any mix of short/long flags.
const RM = String.raw`(^|[\s;|&(])rm(?:${WS}-{1,2}[A-Za-z-]+)*${WS}`
// Q — optional shell quote around a path token.
const Q = String.raw`["']?`

const RULES: Array<{ pattern: RegExp; reason: string }> = [
  // 1. Claude auth — the reckit (company) profile must keep working; the
  //    personal profile is decommissioned separately, never by an agent.
  {
    pattern: new RegExp(String.raw`claude${WS}${Q}auth${Q}${WS}${Q}(login|logout)`, "i"),
    reason: "claude auth login/logout is forbidden (irreplaceable/company accounts).",
  },
  // 2. OAuth-token env that can wipe a Claude Keychain login on exit.
  {
    pattern: /CLAUDE_CODE_OAUTH_TOKEN/,
    reason: "Setting CLAUDE_CODE_OAUTH_TOKEN can destroy a Claude Keychain login.",
  },
  // 3. Keychain operations on Claude credentials (any profile).
  {
    pattern: new RegExp(String.raw`security${WS}[\s\S]*(delete-generic-password|claude code-credentials)`, "i"),
    reason: "Keychain operations on Claude credentials are forbidden.",
  },
  // 4. rm touching a Claude profile dir or anything under it (subpaths and
  //    globs are as destructive as the dir itself).
  {
    pattern: new RegExp(String.raw`${RM}[\s\S]*?${Q}(~|\$HOME)${Q}\/(\.\/)*\.claude(-reckit)?(\/|[\s"'\\]|$)`, "i"),
    reason: "Removing a Claude profile directory (or anything inside it) is forbidden.",
  },
  {
    pattern: new RegExp(String.raw`${RM}[\s\S]*?${Q}(~|\$HOME)${Q}\/(\.\/)*(\.config\/opencode|\.local\/share\/opencode)(\/|[\s"'\\]|$)`, "i"),
    reason: "Removing OpenCode's config/data directories is forbidden (auth, db, guard).",
  },
  // 5. Catastrophic recursive deletes of home/root.
  {
    pattern: new RegExp(String.raw`${RM}${Q}(\/|~|~\/|\$HOME|\$HOME\/|\/\*)${Q}([\s;|&]|$)`),
    reason: "Catastrophic rm targeting home/root is forbidden.",
  },
  // 6. Protect the guardrail core from shell rewrites: this file, OpenCode's
  //    auth.json, and Claude's settings/hooks (the Edit tool is blocked for
  //    these by permission rules; this closes the Bash path). The redirect or
  //    verb must lead directly to the guarded path within the same shell
  //    segment (backslash-continuations count as the same segment), so
  //    unrelated redirects (e.g. `2>/dev/null`) in a command that merely
  //    mentions a guarded path don't false-positive.
  {
    pattern: new RegExp(
      String.raw`(>>?(?:\s|\\\r?\n)*|(^|[\s;|&])(tee|cp|mv|ln)(?:\s|\\\r?\n)(?:[^;&|\n]|\\\r?\n)*)\S*(\.config\/opencode\/plugins\/guard\.ts|\.local\/share\/opencode\/auth\.json|\.claude(-reckit)?\/settings\.json|\.config\/claude\/(hooks\/|statusline\.sh))`,
      "i",
    ),
    reason: "Modifying OpenCode/Claude guardrail core files via the shell is blocked (edit manually if you must).",
  },
]

export const GuardPlugin: Plugin = async () => {
  return {
    "tool.execute.before": async (input, output) => {
      if (input.tool !== "bash") return
      const command = output?.args?.command
      if (typeof command !== "string" || command.length === 0) return
      for (const { pattern, reason } of RULES) {
        if (pattern.test(command)) {
          throw new Error(`BLOCKED by guard plugin: ${reason}`)
        }
      }
    },
  }
}
