# ~/.config dotfiles — ALLOWLIST model. Keep this repo PRIVATE.
# Ignore everything, then re-include only the configs we intend to track. This
# stops any tool that drops tokens/state into ~/.config from being committed.
# Review `git status` before each commit. To track more later, add `!name/` and `!name/**` lines.
*

!.gitignore
!Brewfile

# reproduce-on-a-new-Mac runbook + installer
!README.md
!install.sh

# day-to-day driving guide (README rebuilds the machine; this one runs it)
!GUIDE.md

# contexts.toml — the single definition of every context (employer/client/
# personal). bin/ holds this machine's own scripts; `ctx` generates all the
# per-context identity wiring from that spec. Both are load-bearing for
# reproducibility: without them a fresh Mac has no identity switching.
!contexts.toml
!bin/
!bin/**

# launchd agents — copied into ~/Library/LaunchAgents by install.sh (launchd
# does not reliably follow symlinks out of that directory).
!launchd/
!launchd/**

# zsh (relocated here via ZDOTDIR)
!zsh/
!zsh/**
zsh/.zsh_history
zsh/.zcompdump*
zsh/.zsh_sessions/

# git
!git/
!git/**

# mise global tool versions (no secrets; per-project [env] overrides live in
# mise.toml files under ~/work/<company>/, which are NOT part of this repo)
!mise/
!mise/**
mise/.mise.toml

# neovim (config only; plugins live under ~/.local/share/nvim, not here)
!nvim/
!nvim/**
# neovim Flutter layer, used only in ~/work/reckit (via NVIM_APPNAME)
!nvim-flutter/
!nvim-flutter/**
# neovim web/React Native layer — noon, dolab-marcom, freelance (via NVIM_APPNAME)
!nvim-webdev/
!nvim-webdev/**

# ghostty + starship
!ghostty/
!ghostty/**
!starship.toml

# tmux (config only; XDG location, read automatically by tmux 3.2+)
!tmux/
!tmux/**

# claude (system manual, bootstrap script, guard hook, statusline, maintenance agent)
!claude/
!claude/**

# atuin (shell history sync; config only — encryption key + session token live
# under ~/.local/share/atuin/, not here)
!atuin/
!atuin/**

# macOS cruft. Last match wins, so this must stay at the end — the `!bin/**`
# style re-includes above would otherwise pull .DS_Store back in.
.DS_Store
